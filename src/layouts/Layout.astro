---
import { Font } from "astro:assets"
import { LANGUAGES, getCV, getLangPath, type Lang } from "@/i18n"

interface Props {
  title: string
  lang: Lang
}

const { title, lang } = Astro.props

const { image, summary, url } = getCV(lang).basics
const alternates = Object.keys(LANGUAGES) as Lang[]
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={summary} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="image" href={image} />
    <Font cssVariable="--font-sans" preload />
    {
      alternates.length > 1 &&
        alternates.map((alternate) => (
          <link
            rel="alternate"
            hreflang={alternate}
            href={new URL(getLangPath(alternate), Astro.site ?? url)}
          />
        ))
    }

    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />
    <meta property="og:image" content="" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content={url.split("//")[1] ?? ""} />
    <meta property="twitter:url" content={url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={summary} />
    <meta name="twitter:image" content="" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --color-paper: #ffffff;
    --color-ink: #15171c;
    --color-text: #3d414a;
    --color-muted: #6b707a;
    --color-rule: #e5e7eb;
    --color-wash: #f2f3f5;
    --color-accent: #2448c9;
    --color-live: #1a9a4b;

    --label-col: 9.5rem;
    --gutter: 2.5rem;
    --content-col: 34rem;

    color-scheme: light dark;
  }

  @media screen and (prefers-color-scheme: dark) {
    :root {
      --color-paper: #121418;
      --color-ink: #f2f3f5;
      --color-text: #c3c7ce;
      --color-muted: #8d929b;
      --color-rule: #262a31;
      --color-wash: #1d2026;
      --color-accent: #8ea9ff;
      --color-live: #3ecf75;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-sans);
    font-size: 100%;
    line-height: 1.6;
    color: var(--color-text);
    background: var(--color-paper);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-size-adjust: 100%;
    -webkit-text-size-adjust: 100%;
    scrollbar-width: thin;
    scrollbar-color: var(--color-rule) transparent;
  }

  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  ::-webkit-scrollbar-thumb {
    background-color: var(--color-rule);
    border-radius: 1rem;
  }
  ::-webkit-scrollbar-thumb:hover {
    background-color: var(--color-muted);
  }
  ::-webkit-scrollbar-track {
    background-color: transparent;
  }

  ::selection {
    color: var(--color-paper);
    background: var(--color-ink);
  }

  body,
  figure,
  h1,
  h2,
  h3,
  h4,
  p {
    margin: 0;
  }

  body {
    padding: 0;
  }

  h1,
  h2,
  h3,
  h4 {
    color: var(--color-ink);
    font-weight: 600;
    text-wrap: balance;
  }

  p {
    text-wrap: pretty;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  ul,
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
  }

  button {
    font: inherit;
    color: inherit;
  }

  :focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .print {
    display: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      transition-duration: 0s !important;
      animation-duration: 0s !important;
    }
  }

  @page {
    size: A4;
    margin: 14mm 16mm;
  }

  @media print {
    :root {
      --label-col: 9rem;
      --gutter: 1.5rem;
    }

    html {
      font-size: 11.5px;
    }

    .no-print {
      display: none !important;
    }

    .print {
      display: flex !important;
    }

    astro-dev-toolbar {
      display: none !important;
    }

    article {
      break-inside: avoid;
    }
  }
</style>
