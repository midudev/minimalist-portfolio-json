---
import { formatMonthYear, useTranslations, type Lang } from "@/i18n"

interface Props {
  lang: Lang
  title: string
  url?: string
  linkTitle?: string
  subtitle: string
  startDate: string
  endDate: string | null
  summary?: string
}

const { lang, title, url, linkTitle, subtitle, startDate, endDate, summary } =
  Astro.props
const t = useTranslations(lang)

const startYear = new Date(startDate).getFullYear()
const endYear = endDate != null ? new Date(endDate).getFullYear() : null
---

<article>
  <header>
    <h3>
      {
        url ? (
          <a href={url} title={linkTitle} target="_blank" rel="noopener noreferrer">
            {title}
          </a>
        ) : (
          title
        )
      }
    </h3>
    <p class="dates">
      <time datetime={startDate} data-title={formatMonthYear(lang, startDate)}>
        {startYear}
      </time>
      {" – "}
      {
        endDate != null ? (
          <time datetime={endDate} data-title={formatMonthYear(lang, endDate)}>
            {endYear}
          </time>
        ) : (
          <span>{t("date.present")}</span>
        )
      }
    </p>
  </header>
  <p class="subtitle">{subtitle}</p>
  {summary && <p class="summary">{summary}</p>}
</article>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  h3 {
    font-size: 1rem;
    line-height: 1.5rem;
  }

  h3 a {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.15s ease;
  }

  h3 a:hover {
    text-decoration-color: var(--color-accent);
  }

  .dates {
    flex: none;
    color: var(--color-muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .subtitle {
    color: var(--color-text);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .summary {
    max-width: var(--content-col);
    margin-top: 0.5rem;
    font-size: 0.9375rem;
  }

  [data-title] {
    position: relative;
    cursor: default;
  }

  [data-title]::after {
    content: attr(data-title);
    position: absolute;
    top: calc(100% + 0.25rem);
    right: 0;
    z-index: 10;
    padding: 0.25rem 0.5rem;
    color: var(--color-paper);
    background: var(--color-ink);
    border-radius: 0.375rem;
    font-size: 0.75rem;
    line-height: 1.2;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    translate: 0 -2px;
    transition:
      opacity 0.15s ease,
      translate 0.15s ease,
      visibility 0.15s;
  }

  [data-title]:hover::after {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    transition-delay: 0.3s;
  }

  @media print {
    [data-title]::after {
      display: none;
    }
  }
</style>
