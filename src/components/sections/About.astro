---
import Section from "../Section.astro"

import { getCV, useTranslations, type Lang } from "@/i18n"

const { lang } = Astro.props as { lang: Lang }
const { summary } = getCV(lang).basics
const t = useTranslations(lang)
---

<Section title={t("about.title")}>
  <p>
    {summary}
  </p>
</Section>

<style>
  p {
    max-width: var(--content-col);
    line-height: 1.5rem;
  }
</style>
