---
import { getCV, useTranslations, type Lang } from "@/i18n"
import Mail from "@/icons/Mail.astro"
import Phone from "@/icons/Phone.astro"
import X from "@/icons/X.astro"
import LinkedIn from "@/icons/LinkedIn.astro"
import GitHub from "@/icons/GitHub.astro"
import WorldMap from "@/icons/WorldMap.astro"
import Stackoverflow from "@/icons/Stackoverflow.astro"
import type { SocialIcon } from "@/types"

const { lang } = Astro.props as { lang: Lang }
const { name, label, image, location, profiles, phone, email, url } =
  getCV(lang).basics
const { city, region } = location
const t = useTranslations(lang)

const SOCIAL_ICONS: SocialIcon = {
  GitHub,
  LinkedIn,
  X,
  Stackoverflow
}

const linkedInfo = profiles.find(({ network }) => network === "LinkedIn")
const linkedUrl = linkedInfo?.url

const withoutProtocol = (link: string) => link.replace(/^https?:\/\//, "")

const printInfo = [
  email && { href: `mailto:${email}`, text: email },
  phone && { href: `tel:${phone}`, text: phone },
  url && { href: url, text: withoutProtocol(url) },
  linkedUrl && { href: linkedUrl, text: withoutProtocol(linkedUrl) }
].filter(Boolean) as { href: string; text: string }[]
---

<header>
  <div class="info">
    <h1>{name}</h1>
    <p class="label">{label}</p>
    <p class="location">
      <WorldMap />
      {city}, {region}
    </p>

    <ul class="contact no-print">
      {
        email && (
          <li>
            <a
              href={`mailto:${email}`}
              title={t("hero.email", { name, email })}
              aria-label={t("hero.email", { name, email })}
            >
              <Mail />
            </a>
          </li>
        )
      }
      {
        phone && (
          <li>
            <a
              href={`tel:${phone}`}
              title={t("hero.phone", { name, phone })}
              aria-label={t("hero.phone", { name, phone })}
            >
              <Phone />
            </a>
          </li>
        )
      }
      {
        profiles.map(({ network, url }) => {
          const Icon = SOCIAL_ICONS[network]

          return (
            <li>
              <a
                href={url}
                title={t("hero.profile", { name, network })}
                aria-label={t("hero.profile", { name, network })}
                target="_blank"
                rel="noopener noreferrer"
              >
                {Icon ? <Icon /> : network[0]}
              </a>
            </li>
          )
        })
      }
    </ul>

    <ul class="print">
      {
        printInfo.map(({ href, text }) => (
          <li>
            <a href={href}>{text}</a>
          </li>
        ))
      }
    </ul>
  </div>

  <img src={image} alt={name} width="128" height="128" />
</header>

<style>
  header {
    display: grid;
    grid-template-columns: var(--label-col) minmax(0, 1fr);
    column-gap: var(--gutter);
    align-items: start;
  }

  .info {
    grid-column: 2;
    grid-row: 1;
  }

  img {
    grid-column: 1;
    grid-row: 1;
    width: 6.5rem;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 0.875rem;
    background: var(--color-wash);
  }

  h1 {
    font-size: clamp(2.125rem, 1.4rem + 2.6vw, 2.875rem);
    font-weight: 700;
    font-stretch: 112.5%;
    letter-spacing: -0.03em;
    line-height: 1.04;
  }

  .label {
    max-width: 32rem;
    margin-top: 0.875rem;
    color: var(--color-text);
    font-size: 1.0625rem;
    line-height: 1.5;
    text-wrap: balance;
  }

  .location {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.5rem;
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .contact a {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--color-muted);
    border: 1px solid var(--color-rule);
    border-radius: 0.5rem;
    transition:
      color 0.15s ease,
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .contact a:hover {
    color: var(--color-ink);
    background: var(--color-wash);
    border-color: var(--color-wash);
  }

  .print {
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-top: 0.875rem;
    color: var(--color-text);
    font-size: 0.875rem;
  }

  @media screen and (width <= 720px) {
    header {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 1.5rem;
    }

    .info,
    img {
      grid-column: 1;
    }

    .info {
      grid-row: 2;
    }

    img {
      width: 4.5rem;
      border-radius: 0.75rem;
    }
  }

  @media print {
    img {
      width: 5.5rem;
    }
  }
</style>
